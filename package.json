{
  "name": "report-focus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "import:wordpress": "tsx --env-file-if-exists=.env scripts/import-wordpress.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "db:backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "uploads:move": "tsx --env-file-if-exists=.env scripts/move-uploads.ts",
    "sections:review": "tsx --env-file-if-exists=.env scripts/section-review.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@libsql/client": "^0.18.0",
    "@sentry/nextjs": "^10.78.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "entities": "^9.0.0",
    "fast-xml-parser": "^5.11.2",
    "marked": "^18.1.2",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "slugify": "^1.6.9",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
