# SQLite file locally, or a Turso/libSQL URL in production (libsql://...)
DATABASE_URL=file:./data/report-focus.db
# Only needed for Turso
DATABASE_AUTH_TOKEN=
# Where uploaded images are stored
UPLOAD_DIR=./uploads
# Public URL of the site, used for RSS, sitemap and share links
SITE_URL=http://localhost:3000
# Time zone for dates shown on the site and in the newsroom
SITE_TIMEZONE=America/New_York
NEXT_PUBLIC_SITE_TIMEZONE=America/New_York
# Social profile links. X, Facebook, Instagram and LinkedIn default to the Report Focus accounts; set one to override it.
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
# Google AdSense. Ads appear once the publisher ID and a slot ID are set; leave empty for no ads.
# Publisher ID from AdSense > Account, e.g. ca-pub-1234567890123456 (also served at /ads.txt)
ADSENSE_CLIENT=
# Ad unit IDs from AdSense > Ads > By ad unit (display ads). Leave one empty to turn that spot off.
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_ARTICLE=
ADSENSE_SLOT_SIDEBAR=
# Set to "on" to show grey placeholder boxes where ads will go, before AdSense is set up
NEXT_PUBLIC_AD_SLOTS=
# Reader donations: a Paystack, Stripe or PayFast payment page (https://...). Leave empty to hide /support.
DONATE_URL=
# Email for newsletters and breaking-news alerts. "console" writes emails to the server log; "resend" sends them.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Report Focus News <news@reportfocus.news>"
# A long random string. The scheduler that sends the daily newsletters passes it as "Authorization: Bearer <secret>".
CRON_SECRET=
# Image storage. Leave S3_BUCKET empty to keep uploads in UPLOAD_DIR (fine locally, lost on each deploy on most hosts).
# For Cloudflare R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com, S3_REGION=auto,
# and S3_PUBLIC_URL is the bucket's public address, e.g. https://media.reportfocusnews.com
S3_BUCKET=
S3_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# A separate, private bucket for `npm run db:backup`. Never the public image bucket: backups hold password hashes and emails.
BACKUP_S3_BUCKET=
# Error tracking (sentry.io, free plan). SENTRY_DSN reports server errors; NEXT_PUBLIC_SENTRY_DSN (same value) reports
# browser errors and must be set before `npm run build`.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
