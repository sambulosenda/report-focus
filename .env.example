# SQLite file locally, or a Turso/libSQL URL in production (libsql://...)
DATABASE_URL=file:./data/report-focus.db
# Only needed for Turso
DATABASE_AUTH_TOKEN=
# Where uploaded images are stored
UPLOAD_DIR=./uploads
# Public URL of the site, used for RSS, sitemap and share links
SITE_URL=http://localhost:3000
# Time zone for dates shown on the site and in the newsroom
SITE_TIMEZONE=America/New_York
NEXT_PUBLIC_SITE_TIMEZONE=America/New_York
# Footer social links (leave empty until the accounts exist)
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
# Google AdSense. Ads appear once the publisher ID and a slot ID are set; leave empty for no ads.
# Publisher ID from AdSense > Account, e.g. ca-pub-1234567890123456 (also served at /ads.txt)
ADSENSE_CLIENT=
# Ad unit IDs from AdSense > Ads > By ad unit (display ads). Leave one empty to turn that spot off.
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_ARTICLE=
ADSENSE_SLOT_SIDEBAR=
# Set to "on" to show grey placeholder boxes where ads will go, before AdSense is set up
NEXT_PUBLIC_AD_SLOTS=
# Reader donations: a Paystack, Stripe or PayFast payment page (https://...). Leave empty to hide /support.
DONATE_URL=
